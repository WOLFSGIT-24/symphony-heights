---
import { Head } from "@/components/Head";
import AppRouter from "@/components/Router";
import "@/styles/global.css";

export function getStaticPaths() {
  return [
    { params: { slug: undefined } },
    { params: { slug: 'privacy-policy' } },
    { params: { slug: '404' } },
  ];
}

const title = "Symphony Heights | Boutique 3 BHK Residences in Hennur, Bangalore";
const description = "Introducing Symphony Heights by Disha Properties — a boutique community of 128 premium 3 BHK residences in Hennur, North Bangalore. Starting ₹1.9 Cr with exclusive 25:25:25:25 Flexi Payment Plan. RERA Approved.";
const siteUrl = Astro.url.href;
const ogImage = "/hero-bg.webp";
---

<!doctype html>
<html lang="en" class="w-full h-full scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="Symphony Heights, Disha Properties, 3 BHK Hennur, apartments in Hennur, luxury apartments North Bangalore, Hennur Bagalur Road, Manyata Tech Park apartments, RERA approved apartments Bangalore" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={siteUrl} />
    <!-- Preload Hero LCP Resource for Mobile & Desktop -->
    <link rel="preload" as="image" href="/hero-bg-mobile.webp" media="(max-width: 1023px)" fetchpriority="high" type="image/webp" />
    <link rel="preload" as="image" href="/hero-bg.webp" media="(min-width: 1024px)" fetchpriority="high" type="image/webp" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <Head />
  </head>
  <body class="w-full h-full bg-marble text-charcoal antialiased">
    <div id="root" class="w-full h-full">
      <AppRouter client:only="react" />
    </div>
  </body>
</html>
